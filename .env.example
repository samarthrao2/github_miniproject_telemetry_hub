MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=fleet_hub
MYSQL_ROOT_PASSWORD=change_me
# Database-level roles: the app connects as one of these depending on who is logged in.
DB_ADMIN_USER=fleet_admin
DB_ADMIN_PASSWORD=change_me
DB_VIEWER_USER=fleet_viewer
DB_VIEWER_PASSWORD=change_me

# Web-app logins created by the seed script
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=change_me
SESSION_SECRET=change_me_to_a_long_random_string

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=failure_reports

# Embeddings: "local" (Transformers.js, no key needed) or "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=384
# OPENAI_API_KEY=
DB_AUTH_USER=fleet_auth
DB_AUTH_PASSWORD=change_me
